# Optional. Without it the app serves its own generated world, which is fully functional.
# With it, live RailRadar data is used where the API covers it.
# Get a key at https://railradar.in — server-side only, never exposed to the browser.
RAILRADAR_API_KEY=

# Optional. Enables voice navigation (Sarvam STT + TTS). Server-side only.
SARVAM_API_KEY=

# Optional. Enables live Anthropic chat. Without it (or with CHAT_FAKE=1) the
# agent uses a scripted replay so Playwright and local demos still work.
ANTHROPIC_API_KEY=
CHAT_FAKE=

# Optional. Enables the booking chat (Claude Haiku). Server-side only.
# Without it the chat still runs against a scripted transport, so tests and
# demos keep working. There is no model picker — Haiku is hardcoded.
ANTHROPIC_API_KEY=
