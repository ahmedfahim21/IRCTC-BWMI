# Optional. Without it the app serves its own generated world, which is fully functional.
# With it, live RailRadar data is used where the API covers it.
# Get a key at https://railradar.in — server-side only, never exposed to the browser.
RAILRADAR_API_KEY=

# Optional. Enables voice navigation (Sarvam STT + TTS). Server-side only.
SARVAM_API_KEY=

# Optional. Enables live Anthropic chat (Sonnet 4.5 is hardcoded — no picker).
# Without it, or with CHAT_FAKE=1, a scripted replay covers Playwright.
ANTHROPIC_API_KEY=
CHAT_FAKE=
