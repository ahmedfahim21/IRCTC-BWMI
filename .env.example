# Optional. Without it the app serves its own generated world, which is fully functional.
# With it, live RailRadar data is used where the API covers it.
# Get a key at https://railradar.in — server-side only, never exposed to the browser.
RAILRADAR_API_KEY=

# Optional. Enables in-chat voice (Sarvam STT + optional speak-back TTS). Server-side only.
SARVAM_API_KEY=

# Optional. Live chat provider: anthropic | bedrock-oss | bedrock-luna
# Aliases: claude, gpt-oss, luna. Defaults to anthropic when unset.
CHAT_PROVIDER=anthropic
MODEL=

# Anthropic (CHAT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Bedrock (CHAT_PROVIDER=bedrock-oss or bedrock-luna)
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Without credentials for the active provider, or with CHAT_FAKE=1, a scripted replay covers Playwright.
CHAT_FAKE=
